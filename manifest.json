{
  "manifest_version": 3,
  "name": "Smart Shopper",
  "version": "1.0.0",
  "description": "Trouvez le meilleur prix pour le même produit sur AliExpress",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.aliexpress.us/*",
    "https://smart-shopper.smailsuit11.workers.dev/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*"
      ],
      "js": ["content/i18n.js", "content/content.js", "content/fullscreen.js"],
      "css": ["content/content.css", "content/fullscreen.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Smart Shopper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}